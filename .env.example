# Copy to .env (never commit .env). Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPTPLAT_API_TOKEN=
OPTPLAT_BROKER=sim            # sim | ibkr_paper
OPTPLAT_DB=optplat.db
OPTPLAT_PORT=8800

# Only used when OPTPLAT_BROKER=ibkr_paper (paper accounts start with DU)
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_PAPER_ACCOUNT=
